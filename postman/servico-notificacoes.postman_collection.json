{
  "info": {
    "name": "Serviço de Notificações",
    "description": "Rotas do serviço de notificações. Rode primeiro \"Gerar token (dev)\": ele assina um JWT com o secret de desenvolvimento e salva em {{token}}, usado pelas demais rotas. Troque as variáveis role/sub da collection para simular outro usuário (cliente, loja, entregador).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://44.192.118.93:8082"
    },
    {
      "key": "jwtSecret",
      "value": "dev-secret-troque-isso"
    },
    {
      "key": "role",
      "value": "cliente"
    },
    {
      "key": "sub",
      "value": "42"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "deviceToken",
      "value": "device-teste-123"
    },
    {
      "key": "rabbitApi",
      "value": "http://44.192.118.93:15672"
    },
    {
      "key": "rabbitUser",
      "value": "guest"
    },
    {
      "key": "rabbitPass",
      "value": "guest"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Gerar token (dev)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Assina um JWT HS256 com o secret de dev, como o backend faria.",
              "const b64url = (wa) => CryptoJS.enc.Base64.stringify(wa).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const enc = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
              "const role = pm.collectionVariables.get('role');",
              "const sub = pm.collectionVariables.get('sub');",
              "const header = enc({ alg: 'HS256', typ: 'JWT' });",
              "const payload = enc({ role, sub: isNaN(sub) ? sub : Number(sub), iat: Math.floor(Date.now() / 1000) });",
              "const assinatura = b64url(CryptoJS.HmacSHA256(header + '.' + payload, pm.collectionVariables.get('jwtSecret')));",
              "const token = header + '.' + payload + '.' + assinatura;",
              "pm.collectionVariables.set('token', token);",
              "console.log('token gerado para', role + ':' + sub, token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Gera o token em {{token}} (script de pré-requisição) e aproveita para chamar o /health."
      }
    },
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
